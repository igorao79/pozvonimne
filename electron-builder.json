{
  "appId": "com.pozvonimne.app",
  "productName": "Позвони.мне",
  "copyright": "Copyright © 2025 Позвони.мне",
  "publish": {
    "provider": "github",
    "owner": "igorao79", 
    "repo": "pozvonimne",
    "private": false,
    "releaseType": "release"
  },
  "directories": {
    "output": "release",
    "buildResources": "electron"
  },
  "generateUpdatesFilesForAllChannels": true,
  "detectUpdateChannel": true,
  "files": [
    "out/**/*",
    "electron/main.js",
    "electron/preload.js", 
    "electron/webrtc-fix.js",
    "electron/splash.html",
    "electron/logo.png",
    "package.json",
    "node_modules/**/*",
    "!node_modules/**/*.md",
    "!node_modules/**/*.txt",
    "!node_modules/**/*.map",
    "!node_modules/**/.cache/**/*",
    "!node_modules/**/test/**/*",
    "!node_modules/**/tests/**/*",
    "!node_modules/**/spec/**/*",
    "!node_modules/**/__tests__/**/*",
    "!node_modules/**/docs/**/*",
    "!node_modules/**/doc/**/*",
    "!node_modules/**/example/**/*",
    "!node_modules/**/examples/**/*",
    "!node_modules/**/demo/**/*",
    "!node_modules/**/demos/**/*",
    "!node_modules/**/.nyc_output/**/*",
    "!node_modules/**/coverage/**/*",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.flow",
    "!node_modules/**/.eslint*",
    "!node_modules/**/LICENSE*",
    "!node_modules/**/CHANGELOG*",
    "!node_modules/**/HISTORY*",
    "!node_modules/**/CONTRIBUTING*",
    "!node_modules/**/AUTHORS*",
    "!node_modules/**/CONTRIBUTORS*",
    "!**/{*.ts,*.coffee}",
    "!**/{tsconfig.json,*.config.js,*.config.ts}"
  ],
  "extraResources": [
    {
      "from": "public",
      "to": "public",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable", 
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "public/logo.png",
    "verifyUpdateCodeSignature": false,
    "legalTrademarks": "Позвони.мне",
    "requestedExecutionLevel": "asInvoker"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "public/logo.icns",
    "category": "public.app-category.productivity",
    "entitlements": "electron/entitlements.plist",
    "entitlementsInherit": "electron/entitlements.plist",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      }
    ],
    "icon": "public/logo.png",
    "category": "Network",
    "synopsis": "Простое приложение для голосовых звонков",
    "description": "Простое и безопасное приложение для аудио звонков с WebRTC"
  },
  "portable": {
    "artifactName": "pozvonimne-portable-${version}.${ext}"
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ],
    "window": { "width": 540, "height": 380 },
    "icon": "public/logo.icns",
    "format": "ULFO"
  },
  "compression": "maximum",
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "nodeVersion": "18.17.0",
  "asar": true,
  "asarUnpack": [],
  "electronLanguages": ["en", "ru"],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Позвони.мне",
    "differentialPackage": true
  }
}
