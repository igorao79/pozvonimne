{
  "appId": "com.pozvonimne.app",
  "productName": "Позвони.мне",
  "copyright": "Copyright © 2025 Позвони.мне",
  "publish": {
    "provider": "github",
    "owner": "igorao79", 
    "repo": "pozvonimne",
    "private": false,
    "releaseType": "release"
  },
  "directories": {
    "output": "release",
    "buildResources": "electron"
  },
  "generateUpdatesFilesForAllChannels": true,
  "detectUpdateChannel": true,
  "files": [
    "out/**/*",
    "electron/main.js",
    "electron/preload.js", 
    "electron/webrtc-fix.js",
    "electron/splash.html",
    "electron/logo.png",
    "package.json",
    "node_modules/**/*",
    "!node_modules/**/*.md",
    "!node_modules/**/*.txt",
    "!node_modules/**/*.map",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.flow",
    "!node_modules/**/*.json.map",
    "!node_modules/**/*.coffee",
    "!node_modules/**/*.ts",
    "!node_modules/**/.cache/**/*",
    "!node_modules/**/test/**/*",
    "!node_modules/**/tests/**/*",
    "!node_modules/**/spec/**/*",
    "!node_modules/**/__tests__/**/*",
    "!node_modules/**/__test__/**/*",
    "!node_modules/**/docs/**/*",
    "!node_modules/**/doc/**/*",
    "!node_modules/**/documentation/**/*",
    "!node_modules/**/example/**/*",
    "!node_modules/**/examples/**/*",
    "!node_modules/**/demo/**/*",
    "!node_modules/**/demos/**/*",
    "!node_modules/**/sample/**/*",
    "!node_modules/**/samples/**/*",
    "!node_modules/**/.nyc_output/**/*",
    "!node_modules/**/coverage/**/*",
    "!node_modules/**/.eslint*",
    "!node_modules/**/.prettier*",
    "!node_modules/**/.babel*",
    "!node_modules/**/webpack.config.*",
    "!node_modules/**/rollup.config.*",
    "!node_modules/**/jest.config.*",
    "!node_modules/**/karma.config.*",
    "!node_modules/**/LICENSE*",
    "!node_modules/**/CHANGELOG*",
    "!node_modules/**/CHANGES*",
    "!node_modules/**/HISTORY*",
    "!node_modules/**/NEWS*",
    "!node_modules/**/CONTRIBUTING*",
    "!node_modules/**/AUTHORS*",
    "!node_modules/**/CONTRIBUTORS*",
    "!node_modules/**/README*",
    "!node_modules/**/readme*",
    "!node_modules/**/.travis*",
    "!node_modules/**/.github/**/*",
    "!node_modules/**/.gitlab*",
    "!node_modules/**/.circleci/**/*",
    "!node_modules/**/appveyor.yml",
    "!node_modules/**/.gitignore",
    "!node_modules/**/.gitmodules",
    "!node_modules/**/.gitattributes",
    "!node_modules/**/.editorconfig",
    "!node_modules/**/Makefile*",
    "!node_modules/**/CMakeLists.txt",
    "!node_modules/**/Gruntfile*",
    "!node_modules/**/gulpfile*",
    "!node_modules/**/*.gyp",
    "!node_modules/**/*.gypi",
    "!node_modules/**/bower.json",
    "!node_modules/**/composer.json",
    "!node_modules/**/.bower*",
    "!node_modules/**/.jshint*",
    "!node_modules/**/.jscs*",
    "!node_modules/**/*.yml",
    "!node_modules/**/*.yaml",
    "!node_modules/**/*.xml",
    "!node_modules/**/*.png",
    "!node_modules/**/*.jpg",
    "!node_modules/**/*.jpeg",
    "!node_modules/**/*.gif",
    "!node_modules/**/*.ico",
    "!node_modules/**/*.woff",
    "!node_modules/**/*.woff2",
    "!node_modules/**/*.ttf",
    "!node_modules/**/*.eot",
    "!node_modules/**/*.svg",
    "!node_modules/**/locale/**/*",
    "!node_modules/**/locales/**/*",
    "!node_modules/**/lang/**/*",
    "!node_modules/**/i18n/**/*",
    "!node_modules/**/intl/**/*",
    "!node_modules/**/*.node",
    "!node_modules/**/man/**/*",
    "!node_modules/**/scripts/**/*",
    "!node_modules/**/bin/**/*",
    "!node_modules/**/.bin/**/*",
    "!node_modules/**/build/**/*",
    "!node_modules/**/src/**/*.ts",
    "!node_modules/**/src/**/*.tsx",
    "!node_modules/**/types/**/*",
    "!node_modules/**/@types/**/*",
    "!node_modules/**/node-gyp/**/*",
    "!node_modules/**/node-pre-gyp/**/*",
    "!node_modules/**/gyp/**/*",
    "!node_modules/**/@img/**/*",
    "!node_modules/**/sharp/**/*",
    "!node_modules/**/@img/sharp-darwin-arm64/**/*",
    "!node_modules/**/@img/sharp-darwin-x64/**/*",
    "!node_modules/**/@img/sharp-linux-arm64/**/*",
    "!node_modules/**/@img/sharp-linux-x64/**/*",
    "!node_modules/**/@img/sharp-win32-ia32/**/*",
    "!**/{*.ts,*.coffee}",
    "!**/{tsconfig.json,*.config.js,*.config.ts}"
  ],
  "extraResources": [
    {
      "from": "public",
      "to": "public",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "public/logo.png",
    "verifyUpdateCodeSignature": false,
    "legalTrademarks": "Позвони.мне",
    "requestedExecutionLevel": "asInvoker"
  },
  "compression": "maximum",
  "removePackageScripts": true,
  "removePackageKeywords": true,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "npmRebuild": false,
  "nodeVersion": "18.17.0",
  "asar": true,
  "asarUnpack": [],
  "electronLanguages": ["en", "ru"],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Позвони.мне",
    "differentialPackage": true
  }
}
