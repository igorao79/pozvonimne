{
  "name": "pozvonimne",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "description": "Простое и безопасное приложение для аудио звонков с WebRTC",
  "author": "igorao79 <igorao79@example.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorao79/pozvonimne.git"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "build:electron": "npm run build && npm run build:electron:app",
    "build:next": "cross-env NODE_ENV=production npm run build",
    "build:electron:app": "cross-env ELECTRON_BUILD=true NODE_ENV=production npx electron-builder",
    "build:electron:win": "cross-env ELECTRON_BUILD=true NODE_ENV=production npx electron-builder --config electron-builder.win.json",
    "build:electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "build:electron:prod": "npm run build:electron",
    "start": "next start",
    "electron": "cross-env NODE_ENV=development electron electron/main.js",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "dev:electron": "node electron/dev-server.js",
    "electron:standalone": "cross-env NODE_ENV=production npx electron electron/standalone.js",
    "electron:simple": "node electron/simple-dev.js",
    "electron:pack": "npm run build:electron",
    "electron:dist": "npm run build:electron",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true npm run build",
    "clean": "next build --clean",
    "postbuild": "echo Build completed successfully"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "emoji-picker-react": "^4.13.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "node-emoji": "^2.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-intersection-observer": "^9.16.0",
    "react-loading-skeleton": "^3.5.0",
    "simple-peer": "^9.11.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/json5": "^0.0.30",
    "@types/node": "^20.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/simple-peer": "^9.11.8",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "node-fetch": "^3.3.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
