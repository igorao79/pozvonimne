{
  "name": "pozvonimne",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "description": "Простое и безопасное приложение для аудио звонков с WebRTC",
  "author": "igorao79 <igorao79@example.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/igorao79/pozvonimne.git"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "build:electron": "npm run build && npm run build:electron:app",
    "build:next": "cross-env NODE_ENV=production npm run build",
    "build:electron:app": "cross-env ELECTRON_BUILD=true NODE_ENV=production npx electron-builder",
    "build:electron:win": "cross-env ELECTRON_BUILD=true NODE_ENV=production npx electron-builder --config electron-builder.win.json",
    "build:electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "build:electron:prod": "npm run build:electron",
    "start": "next start",
    "electron": "cross-env NODE_ENV=development electron electron/main.js",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.js",
    "dev:electron": "node electron/dev-server.js",
    "electron:standalone": "cross-env NODE_ENV=production npx electron electron/standalone.js",
    "electron:simple": "node electron/simple-dev.js",
    "electron:pack": "npm run build:electron",
    "electron:dist": "npm run build:electron",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true npm run build",
    "clean": "next build --clean",
    "postbuild": "echo Build completed successfully",
    "test:updater": "cross-env NODE_ENV=production electron electron/test-updater-window.js",
    "test:update-server": "node scripts/test-update-server.js",
    "test:update-config": "node scripts/check-update-config.js",
    "mobile:build": "cross-env CAPACITOR_BUILD=true npm run build",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:add:ios": "npx cap add ios",
    "mobile:add:android": "npx cap add android",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "mobile:run:ios": "npx cap run ios",
    "mobile:run:android": "npx cap run android",
    "mobile:update": "npm run mobile:build && npx cap update",
    "mobile:copy": "npx cap copy"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/network": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/react-color": "^3.0.13",
    "@uiw/react-color": "^2.9.2",
    "cloudinary": "^2.8.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "emoji-picker-react": "^4.13.3",
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "next-cloudinary": "^6.17.4",
    "node-emoji": "^2.2.0",
    "react": "19.1.0",
    "react-color": "^2.19.3",
    "react-dom": "19.1.0",
    "react-intersection-observer": "^9.16.0",
    "react-loading-skeleton": "^3.5.0",
    "simple-peer": "^9.11.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/json5": "^0.0.30",
    "@types/node": "^20.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/simple-peer": "^9.11.8",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "node-fetch": "^3.3.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
