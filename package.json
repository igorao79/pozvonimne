{
  "name": "pozvonimne",
  "version": "0.1.40",
  "private": true,
  "homepage": "https://pozvonimne.vercel.app",
  "description": "Simple voice calling app with WebRTC",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "rimraf .next && next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "dev:electron": "set NODE_ENV=development && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:electron:simple": "set NODE_ENV=development && electron electron/simple-dev.js",
    "build:next": "set NODE_ENV=production && npm run build",
    "build:electron": "npm run optimize:build && npm run build:next && npm run build:electron:app",
    "build:electron:fast": "npm run build:next && npm run build:electron:app",
    "build:electron:app": "set ELECTRON_BUILD=true && set NODE_ENV=production && electron-builder --config electron-builder.json",
    "test:local": "electron electron/test-local.js",
    "optimize:build": "node scripts/optimize-build.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gsap": "^3.12.8",
    "lucide-react": "^0.469.0",
    "next": "15.5.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@gsap/react": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.3.9",
    "eslint": "^8",
    "eslint-config-next": "15.5.3",
    "next-sitemap": "^4.2.3",
    "postcss": "^8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pozvonimne.app",
    "productName": "Позвони.мне",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/main.js",
      "electron/preload.js",
      "package.json"
    ]
  }
}